        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="Conceptual domain model. Advisor and Administrator are User roles. Student actual outcomes are retained only for demonstration and evaluation; predictions do not replace them." vertex="1">
