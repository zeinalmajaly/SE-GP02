<mxfile host="app.diagrams.net" type="device">
  <diagram id="class" name="Class Diagram">
    <mxGraphModel dx="1700" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Class Diagram - AI Student Success and Dropout-Risk Support System" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="1200" height="45" as="geometry"/></mxCell>
        <mxCell id="note" value="Conceptual domain model. Advisor and Administrator are User roles; the exact implementation may refine these classes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="80" width="1000" height="45" as="geometry"/></mxCell>

        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;hr/&gt;- userId: UUID&lt;br/&gt;- username: String&lt;br/&gt;- passwordHash: String&lt;br/&gt;- displayName: String&lt;br/&gt;- role: UserRole&lt;br/&gt;- isActive: Boolean&lt;br/&gt;&lt;hr/&gt;+ signIn(credentials)&lt;br/&gt;+ signOut()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="360" height="235" as="geometry"/></mxCell>
        <mxCell id="student" value="&lt;b&gt;StudentRecord&lt;/b&gt;&lt;hr/&gt;- studentId: String (synthetic)&lt;br/&gt;- syntheticName: String&lt;br/&gt;- course: String&lt;br/&gt;- featureValues: Map&lt;br/&gt;- actualOutcome: OutcomeClass&lt;br/&gt;&lt;hr/&gt;+ getProfile()&lt;br/&gt;+ getModelInputs()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="400" height="225" as="geometry"/></mxCell>
        <mxCell id="model" value="&lt;b&gt;ModelVersion&lt;/b&gt;&lt;hr/&gt;- versionId: String&lt;br/&gt;- artifactPath: String&lt;br/&gt;- publishedAt: DateTime&lt;br/&gt;- evaluationMetrics: Map&lt;br/&gt;- limitations: Text&lt;br/&gt;- globalFeatureSummary: Map&lt;br/&gt;&lt;hr/&gt;+ loadArtifact()&lt;br/&gt;+ getModelInformation()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1240" y="170" width="400" height="245" as="geometry"/></mxCell>

        <mxCell id="prediction" value="&lt;b&gt;Prediction&lt;/b&gt;&lt;hr/&gt;- predictionId: UUID&lt;br/&gt;- predictedOutcome: OutcomeClass&lt;br/&gt;- dropoutProbability: Decimal&lt;br/&gt;- enrolledProbability: Decimal&lt;br/&gt;- graduateProbability: Decimal&lt;br/&gt;- explanationFactors: List&lt;br/&gt;- generatedAt: DateTime&lt;br/&gt;- decisionStatus: DecisionStatus&lt;br/&gt;- decisionReason: Text?&lt;br/&gt;&lt;hr/&gt;+ recordOverride(outcome, reason)&lt;br/&gt;+ recordDismissal(reason)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="485" width="500" height="315" as="geometry"/></mxCell>

        <mxCell id="followup" value="&lt;b&gt;FollowUpAction&lt;/b&gt;&lt;hr/&gt;- actionId: UUID&lt;br/&gt;- actionType: String&lt;br/&gt;- note: Text&lt;br/&gt;- assigneeUserId: UUID?&lt;br/&gt;- dueDate: Date?&lt;br/&gt;- status: FollowUpStatus&lt;br/&gt;- createdAt: DateTime&lt;br/&gt;&lt;hr/&gt;+ addNote(note)&lt;br/&gt;+ changeStatus(status)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="420" height="270" as="geometry"/></mxCell>
        <mxCell id="history" value="&lt;b&gt;FollowUpStatusHistory&lt;/b&gt;&lt;hr/&gt;- historyId: UUID&lt;br/&gt;- oldStatus: FollowUpStatus?&lt;br/&gt;- newStatus: FollowUpStatus&lt;br/&gt;- note: Text?&lt;br/&gt;- changedAt: DateTime&lt;br/&gt;- changedByUserId: UUID&lt;br/&gt;&lt;hr/&gt;+ appendChange()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="650" y="875" width="420" height="225" as="geometry"/></mxCell>
