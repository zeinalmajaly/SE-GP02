        <mxCell id="e6" value="optional prediction link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeWidth=1.5;strokeColor=#555555;dashed=1;dashPattern=6 4;exitX=1;exitY=0.85;entryX=1;entryY=0.9;" edge="1" parent="1" source="prediction" target="followup"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="770"/><mxPoint x="1160" y="1080"/><mxPoint x="500" y="1080"/></Array></mxGeometry></mxCell>
