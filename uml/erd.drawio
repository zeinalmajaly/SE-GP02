        <mxCell id="relNote" value="One bar = one; crow’s foot = many; circle = optional (zero). AUDIT_EVENT.target_id is polymorphic and has no single-table foreign key." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1220" width="900" height="40" as="geometry"/></mxCell>
