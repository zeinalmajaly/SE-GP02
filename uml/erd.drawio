<mxfile host="app.diagrams.net" type="device">
  <diagram id="erd" name="Entity Relationship Diagram">
    <mxGraphModel dx="1700" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Entity Relationship Diagram - AI Student Success and Dropout-Risk Support System" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="25" width="1260" height="45" as="geometry"/></mxCell>
        <mxCell id="note" value="Proposed logical schema. Identities are synthetic; actual outcomes are retained for demonstration/evaluation only. Multiplicities are shown with crow’s-foot ends. Nullable foreign keys are optional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="1100" height="50" as="geometry"/></mxCell>

        <mxCell id="user" value="&lt;b&gt;USER&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; user_id : UUID&lt;br/&gt;username : String (unique)&lt;br/&gt;password_hash : String&lt;br/&gt;display_name : String&lt;br/&gt;role : Advisor | Administrator&lt;br/&gt;is_active : Boolean&lt;br/&gt;created_at : DateTime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="360" height="235" as="geometry"/></mxCell>
        <mxCell id="student" value="&lt;b&gt;STUDENT_RECORD&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; student_id : String (synthetic)&lt;br/&gt;synthetic_name : String&lt;br/&gt;course : String&lt;br/&gt;feature_values : JSON / structured fields&lt;br/&gt;actual_outcome : OutcomeClass&lt;br/&gt;created_at : DateTime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="400" height="225" as="geometry"/></mxCell>
        <mxCell id="model" value="&lt;b&gt;MODEL_VERSION&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; model_version_id : String&lt;br/&gt;artifact_path : String&lt;br/&gt;published_at : DateTime&lt;br/&gt;intended_use : Text&lt;br/&gt;macro_f1 : Decimal&lt;br/&gt;per_class_recall : JSON&lt;br/&gt;confusion_matrix : JSON&lt;br/&gt;limitations : Text&lt;br/&gt;global_feature_summary : JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1240" y="170" width="400" height="285" as="geometry"/></mxCell>

        <mxCell id="prediction" value="&lt;b&gt;PREDICTION&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; prediction_id : UUID&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; student_id : String&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; requested_by_user_id : UUID&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; model_version_id : String&lt;br/&gt;predicted_outcome : OutcomeClass (original)&lt;br/&gt;override_outcome : OutcomeClass?&lt;br/&gt;prob_dropout : Decimal&lt;br/&gt;prob_enrolled : Decimal&lt;br/&gt;prob_graduate : Decimal&lt;br/&gt;explanation_factors : JSON / structured rows&lt;br/&gt;generated_at : DateTime&lt;br/&gt;decision_status : Pending | Overridden | Dismissed&lt;br/&gt;decision_reason : Text?&lt;br/&gt;decision_at : DateTime?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="485" width="500" height="355" as="geometry"/></mxCell>

        <mxCell id="followup" value="&lt;b&gt;FOLLOW_UP_ACTION&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; action_id : UUID&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; student_id : String&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; created_by_user_id : UUID&lt;br/&gt;&lt;b&gt;FK?&lt;/b&gt; assignee_user_id : UUID&lt;br/&gt;&lt;b&gt;FK?&lt;/b&gt; prediction_id : UUID&lt;br/&gt;action_type : String&lt;br/&gt;due_date : Date?&lt;br/&gt;status : FollowUpStatus&lt;br/&gt;created_at : DateTime&lt;br/&gt;updated_at : DateTime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="420" height="260" as="geometry"/></mxCell>
