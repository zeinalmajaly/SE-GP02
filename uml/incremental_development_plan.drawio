<mxfile host="app.diagrams.net">
  <diagram id="incremental-plan" name="Incremental Development Plan">
    <mxGraphModel dx="1900" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#111111;" value="Incremental Development Plan - AI Student Success and Dropout-Risk Support System" vertex="1"><mxGeometry x="30" y="25" width="1500" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#444444;" value="Planned delivery sequence | Each working increment has defined scope, evidence, and requirement coverage" vertex="1"><mxGeometry x="30" y="73" width="1450" height="32" as="geometry"/></mxCell>
        <mxCell id="d1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=14;" value="&lt;b&gt;v0.1.0&lt;/b&gt;&lt;br&gt;DESIGN BASELINE&lt;br&gt;&lt;br&gt;Scope&lt;br&gt;Requirements, architecture, data model, and key workflows.&lt;br&gt;&lt;br&gt;Evidence&lt;br&gt;Project and requirements docs; C4/UML diagrams; class model; ERD; initial traceability.&lt;br&gt;&lt;br&gt;Links&lt;br&gt;FR-01–FR-30; selected NFRs.&lt;br&gt;&lt;br&gt;Status&lt;br&gt;Design artifacts documented." vertex="1"><mxGeometry x="30" y="155" width="345" height="550" as="geometry"/></mxCell>
        <mxCell id="d2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=14;" value="&lt;b&gt;v0.2.0&lt;/b&gt;&lt;br&gt;WORKING INCREMENT 1&lt;br&gt;STUDENT DATA &amp; DASHBOARD&lt;br&gt;&lt;br&gt;Scope&lt;br&gt;Demo roles, synthetic student data, search, filters, profiles, and analytics.&lt;br&gt;&lt;br&gt;Evidence&lt;br&gt;Runnable dashboard; data loader; schema and demo data; setup notes; automated tests.&lt;br&gt;&lt;br&gt;Links&lt;br&gt;FR-01–FR-10; NFR-01, NFR-02, NFR-05–NFR-07, NFR-11, NFR-13–NFR-17.&lt;br&gt;&lt;br&gt;Data&lt;br&gt;Synthetic identities only." vertex="1"><mxGeometry x="410" y="155" width="345" height="550" as="geometry"/></mxCell>
        <mxCell id="d3" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=14;" value="&lt;b&gt;v0.3.0&lt;/b&gt;&lt;br&gt;WORKING INCREMENT 2&lt;br&gt;PREDICTION SERVICE&lt;br&gt;&lt;br&gt;Scope&lt;br&gt;Reproducible training and evaluation; versioned model; advisor estimates, probabilities, history, and disclaimer.&lt;br&gt;&lt;br&gt;Evidence&lt;br&gt;Training scripts; macro-F1, per-class recall, confusion matrix; model metadata; prediction UI/API; tests.&lt;br&gt;&lt;br&gt;Links&lt;br&gt;FR-11–FR-18; NFR-03–NFR-04, NFR-07–NFR-08, NFR-10–NFR-12, NFR-16–NFR-17.&lt;br&gt;&lt;br&gt;Failure behavior&lt;br&gt;Clear error; no fabricated or stale estimate." vertex="1"><mxGeometry x="790" y="155" width="345" height="550" as="geometry"/></mxCell>
        <mxCell id="d4" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=14;" value="&lt;b&gt;v0.4.0&lt;/b&gt;&lt;br&gt;WORKING INCREMENT 3&lt;br&gt;SUPPORT &amp; REPORTING&lt;br&gt;&lt;br&gt;Scope&lt;br&gt;Explanations, override/dismissal, follow-up workflow, admin reports, CSV, users, audit, limitations.&lt;br&gt;&lt;br&gt;Evidence&lt;br&gt;End-to-end workflows; persisted actions and audit; reports; role checks; tests.&lt;br&gt;&lt;br&gt;Links&lt;br&gt;FR-19–FR-30; NFR-01, NFR-04–NFR-10, NFR-13–NFR-17.&lt;br&gt;&lt;br&gt;Use&lt;br&gt;Human review; no automated decisions or interventions." vertex="1"><mxGeometry x="1170" y="155" width="345" height="550" as="geometry"/></mxCell>
        <mxCell id="d5" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;spacing=14;" value="&lt;b&gt;v1.0.0&lt;/b&gt;&lt;br&gt;RELEASE / INTEGRATION&lt;br&gt;COURSE DEMO&lt;br&gt;&lt;br&gt;Scope&lt;br&gt;Integrate increments, resolve defects, verify traceability, prepare clean-machine setup and final demo.&lt;br&gt;&lt;br&gt;Evidence&lt;br&gt;Tagged release; report and test evidence; setup instructions; synthetic-data demo.&lt;br&gt;&lt;br&gt;Links&lt;br&gt;All FR-01–FR-30 and NFR-01–NFR-17.&lt;br&gt;&lt;br&gt;Acceptance&lt;br&gt;Automated tests pass for every working increment before PR merge." vertex="1"><mxGeometry x="1550" y="155" width="345" height="550" as="geometry"/></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="d1" target="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" value=""/><mxCell id="e2" edge="1" parent="1" source="d2" target="d3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" value=""/><mxCell id="e3" edge="1" parent="1" source="d3" target="d4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" value=""/><mxCell id="e4" edge="1" parent="1" source="d4" target="d5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" value=""/>
        <mxCell id="footer" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontColor=#333333;fontSize=14;align=center;verticalAlign=middle;" value="PLANNING NOTES: v0.2.0–v1.0.0 are planned, not completed. Use synthetic identities only; keep raw UCI data out of Git; estimates support human review only." vertex="1"><mxGeometry x="30" y="770" width="1865" height="95" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

